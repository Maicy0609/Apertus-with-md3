<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme for the Compose Multiplatform activity.
      Must be a platform (framework) theme: ComponentActivity does not require
      AppCompat/MaterialComponents, and using a framework theme keeps the app
      free of the com.google.android.material dependency.
      windowBackground matches AppTheme to avoid a white flash on cold start.
    -->
    <style name="Theme.Apertus" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/apertus_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
